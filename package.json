    "test:nwtexte-functional": "electron --no-sandbox scripts/nwtexte-functional-smoke-main.js",
    "test:parcours": "npm run prepare:web && node scripts/parcours-registry-guard.js",
    "test:nvmail": "npm run prepare:web && node scripts/nvmail-architecture-guard.js",
    "test:nvmail-functional": "electron --no-sandbox scripts/nvmail-functional-smoke-main.js",
    "test:autoeval2": "npm run prepare:web && node scripts/autoeval2-architecture-guard.js",
    "test:autoeval2-functional": "electron --no-sandbox scripts/autoeval2-functional-smoke-main.js",
    "test:paronymes": "npm run prepare:web && node scripts/paronymes-architecture-guard.js",
    "test:paronymes-functional": "electron --no-sandbox scripts/paronymes-functional-smoke-main.js",
    "test:carre": "npm run prepare:web && node scripts/carre-architecture-guard.js",
    "test:carre-functional": "electron --no-sandbox scripts/carre-functional-smoke-main.js",
    "test:tri": "npm run prepare:web && node scripts/tri-architecture-guard.js",
    "test:tri-functional": "electron --no-sandbox scripts/tri-functional-smoke-main.js",
    "test:autoeval1": "npm run prepare:web && node scripts/autoeval1-architecture-guard.js",
    "test:autoeval1-functional": "electron --no-sandbox scripts/autoeval1-functional-smoke-main.js",
    "test:brique": "npm run prepare:web && node scripts/brique-architecture-guard.js",
    "test:brique-functional": "electron --no-sandbox scripts/brique-functional-smoke-main.js",
    "test:stock": "npm run prepare:web && node scripts/stock-architecture-guard.js",
    "test:stock-functional": "electron --no-sandbox scripts/stock-functional-smoke-main.js",
    "test:planning": "npm run prepare:web && node scripts/planning-architecture-guard.js",
    "test:planning-functional": "electron --no-sandbox scripts/planning-functional-smoke-main.js",
    "test:genrenombres": "npm run prepare:web && node scripts/genrenombres-architecture-guard.js",
    "test:genrenombres-functional": "electron --no-sandbox scripts/genrenombres-functional-smoke-main.js",
    "test:dictee": "npm run prepare:web && node scripts/dictee-architecture-guard.js",
    "test:dictee-functional": "electron --no-sandbox scripts/dictee-functional-smoke-main.js",
    "test:qcm-final": "npm run prepare:web && node scripts/qcm-final-architecture-guard.js",
    "test:qcm-final-functional": "electron --no-sandbox scripts/qcm-final-functional-smoke-main.js",
    "test:qcm-page2": "npm run prepare:web && node scripts/qcm-page2-architecture-guard.js",
    "test:qcm-page2-functional": "electron --no-sandbox scripts/qcm-page2-functional-smoke-main.js",
    "test:qcm-page2-1": "npm run prepare:web && node scripts/qcm-page2-1-architecture-guard.js",
    "test:qcm-page2-1-functional": "electron --no-sandbox scripts/qcm-page2-1-functional-smoke-main.js",
    "test:qcm-page3": "npm run prepare:web && node scripts/qcm-page3-architecture-guard.js",
    "test:qcm-page3-functional": "electron --no-sandbox scripts/qcm-page3-functional-smoke-main.js",
    "test:qcm-texte-trous": "npm run prepare:web && node scripts/qcm-texte-trous-architecture-guard.js",
    "test:qcm-texte-trous-functional": "electron --no-sandbox scripts/qcm-texte-trous-functional-smoke-main.js",
    "test:qcm-page4": "npm run prepare:web && node scripts/qcm-page4-architecture-guard.js",
    "test:qcm-page4-functional": "electron --no-sandbox scripts/qcm-page4-functional-smoke-main.js",
    "test:qcm-page5": "npm run prepare:web && node scripts/qcm-page5-architecture-guard.js",
    "test:qcm-page5-functional": "electron --no-sandbox scripts/qcm-page5-functional-smoke-main.js",
