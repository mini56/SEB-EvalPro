    "dist:win": "npm run prepare:web && electron-builder --win --publish never",
    "dist:linux": "npm run prepare:web && electron-builder --linux AppImage --publish never",
    "test:seb-ia": "node scripts/test-seb-ia-v1.js && node scripts/audit-repository-names.js",
    "test:nwtexte": "npm run prepare:web && node scripts/nwtexte-architecture-guard.js",
    "audit:names": "node scripts/audit-repository-names.js",
