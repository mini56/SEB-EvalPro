  "dependencies": {
    "quill": "2.0.3"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.sauvegarde56.sebevalpro",
    "productName": "SEB-éval-PRO",
    "asar": true,
    "compression": "store",
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/candidate-keyguard.exe",
        "to": "candidate-keyguard.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SEB-éval-PRO",
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "SEB-eval-PRO-${version}-Windows-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "SEB-eval-PRO-${version}-Linux.${ext}"
    }
  }
}
