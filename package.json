{
  "name": "seb-evalpro",
  "version": "0.1.0",
  "description": "Application desktop autonome du plateau technique SEB EvalPro",
  "main": "src/main.js",
  "author": "Sauvegarde 56",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.js && node scripts/checkpoint-patch.js && node scripts/full-new-evaluation-reset.js && node scripts/audit-corrections.js && node scripts/bilan-export-fixes.js && node scripts/brique-autoeval-fix.js",
    "start": "npm run prepare:web && electron .",
    "dist:win": "npm run prepare:web && electron-builder --win --publish never",
    "dist:linux": "npm run prepare:web && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.sauvegarde56.sebevalpro",
    "productName": "SEB EvalPro",
    "asar": true,
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SEB EvalPro",
      "deleteAppDataOnUninstall": false,
      "artifactName": "SEB-EvalPro-${version}-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "SEB-EvalPro-${version}-Windows-Portable.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Education",
      "artifactName": "SEB-EvalPro-${version}-Linux.${ext}"
    }
  }
}
